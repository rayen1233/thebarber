# Vercel — Settings → Environment Variables
# Copiez vers .env.local pour scripts/push-catalog.mjs (même valeur que sur Vercel)
ADMIN_SECRET=choose-a-long-random-secret

# Blob (auto when Storage → Blob → Connect to Project):
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=  (on deployments)

# Match your Blob store type in the Vercel dashboard:
# private (default) or public
BLOB_STORE_ACCESS=private
