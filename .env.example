# Vercel — Settings → Environment Variables
ADMIN_SECRET=choose-a-long-random-secret

# Cloudinary (vidéos produit + showroom ORDER)
# Dashboard → Settings → API Keys → « Copy API environment variable » (recommandé)
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Blob (images catalogue + showroom — optionnel si Cloudinary pour vidéos)
# BLOB_READ_WRITE_TOKEN=
# BLOB_STORE_ID=
# VERCEL_OIDC_TOKEN=

BLOB_STORE_ACCESS=private
BLOB_MEDIA_ACCESS=private
